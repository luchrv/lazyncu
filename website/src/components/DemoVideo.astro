---
import { withBase } from '../lib/paths';

interface Props {
  /** Basename of the video files under public/demos/, without extension. */
  name: string;
  fallback: string;
}

const { name, fallback } = Astro.props;
---

<video autoplay muted loop playsinline preload="metadata" width="1200" height="700">
  <source src={withBase(`demos/${name}.webm`)} type="video/webm" />
  <source src={withBase(`demos/${name}.mp4`)} type="video/mp4" />
  {fallback}
</video>

<style>
  video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }
</style>
